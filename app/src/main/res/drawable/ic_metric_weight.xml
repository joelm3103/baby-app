        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5.2,6.8 h13.6 a1.9,1.9 0 0 1 1.9,1.9 v6.6 a1.9,1.9 0 0 1 -1.9,1.9 h-13.6 a1.9,1.9 0 0 1 -1.9,-1.9 v-6.6 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.6,13.8 a4.6,4.6 0 0 1 8.8,0" />
