<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottle feed, FILLED (Phase 22). The soft-filled sibling of ic_glyph_bottle.

  Deliberately a different object from the stroke glyph: this is a silhouette, drawn only as a card's
  large illustration or as a small scattered shape, and at card size (~150dp) a 1.7dp outline would be
  a hairline around nothing. It carries no colour — the tint arrives at runtime, because the same asset
  is drawn at several sizes on a card whose fill differs per activity and per theme.

  A teat, a collar and a body, additive, so the union is one bottle silhouette with no holes to wind.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- collar and body: one path, clockwise, shoulders and base rounded -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.6,4.2 h4.8 v1.4 a2,2 0 0 1 1.4,2 v10.6 a2.8,2.8 0 0 1 -2.8,2.8 h-2 a2.8,2.8 0 0 1 -2.8,-2.8 v-10.6 a2,2 0 0 1 1.4,-2 z" />
    <!-- teat, over the collar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.4,4.4 v-1.6 a1.6,1.6 0 0 1 3.2,0 v1.6 z" />
</vector>
