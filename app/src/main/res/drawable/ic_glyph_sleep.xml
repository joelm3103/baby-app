<?xml version="1.0" encoding="utf-8"?>
<!--
  Sleep: a crescent moon with one sparkle. Outline line-art, tinted at runtime.

  The sparkle is filled: at 18dp a stroked star closes up into a dot, and a dot next to the moon reads
  as a second moon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- crescent -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M20.1,15.3 A9,9 0 1 1 11.4,3.2 A6.4,6.4 0 0 0 20.1,15.3 z" />
    <!-- sparkle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.6,3.4 l0.7,1.9 1.9,0.7 -1.9,0.7 -0.7,1.9 -0.7,-1.9 -1.9,-0.7 1.9,-0.7 z" />
</vector>
