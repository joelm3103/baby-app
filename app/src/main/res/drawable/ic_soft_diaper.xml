<?xml version="1.0" encoding="utf-8"?>
<!--
  Diaper, FILLED (Phase 22). The soft-filled sibling of ic_glyph_diaper, and the same two shapes: a
  waistband ABOVE a rounded pad, the bar wider than the pad.

  The width relationship is the whole point of the object — with the bar narrower than the pad it reads as
  the Solids bowl, which is the mistake the stroke glyph's first version made on the phone. No colour of
  its own; tinted at runtime.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- waistband, rounded, deliberately wider than the pad -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.2,7.2 h13.6 a1.4,1.4 0 0 1 1.4,1.4 v1 a1.4,1.4 0 0 1 -1.4,1.4 h-13.6 a1.4,1.4 0 0 1 -1.4,-1.4 v-1 a1.4,1.4 0 0 1 1.4,-1.4 z" />
    <!-- pad, rounded at the bottom -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.2,10 h11.6 v3.6 a5.8,5.8 0 0 1 -11.6,0 z" />
</vector>
