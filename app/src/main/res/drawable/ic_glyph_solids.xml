<?xml version="1.0" encoding="utf-8"?>
<!--
  Solids: a bowl with a spoon standing in it. Outline line-art, tinted at runtime.

  A bowl alone was a bowl of nothing; the spoon is what says "solids" rather than "dish".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- bowl -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3.6,12 h16.8 a8.4,8.4 0 0 1 -16.8,0 z" />
    <!-- spoon head -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14.4,5.1 a1.7,1.7 0 1 1 3.4,0 a1.7,1.7 0 1 1 -3.4,0" />
    <!-- spoon handle, down into the bowl -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M15,6.4 l-2.6,4.4" />
</vector>
