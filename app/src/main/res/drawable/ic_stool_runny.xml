<!--
  Consistency: Runny — a small mass sinking into a WIDE, flat pool.

  REDRAWN in Phase 14, for the same reason as Mucousy: on the phone the old drawing was three heavy
  circles stacked on an ellipse, and at 16dp inside a chip the whole thing merged into one lumpy blob that
  read the same as Mushy. Two shapes that are supposed to mean different things cannot look alike.

  So the pool is now the point: it is nearly twice the width of the mound and sits below it with visible
  shoulders on both sides. Mushy has no pool at all — it is lumps all the way down — which is the
  difference a parent is being asked to record.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,18.6 a8,2.2 0 1,0 16,0 a8,2.2 0 1,0 -16,0 Z M8.8,14.2 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z M6,16.6 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />
</vector>
