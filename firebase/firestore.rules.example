rules_version = '2';

// BabyLog — Phase 13. Two accounts, one shared log.
//
// This is the TEMPLATE, and it is the only copy in the repository. The real file is
// `firebase/firestore.rules`, which is gitignored because it carries the two accounts' uids — a
// Firebase uid identifies an account, so it is not something this repo publishes.
//
// To use it: copy this file to `firebase/firestore.rules`, replace the two placeholders with the uids of
// the two accounts (Authentication -> Users -> the uid column), then paste the result into the Firebase
// console (Firestore Database -> Rules). Keep those uids in the password manager with the rest of the
// project's credentials, and out of any document that could be shared.
//
// Two rules carry the whole design:
//
//   1. Nothing is readable or writable unless the request is from one of the two uids. That is the real
//      gate — the app's own allow-list only exists so a third account gets a sentence instead of a
//      permission error on a screen that would otherwise look empty.
//   2. Only `children`, `events`, `foods_pending` and `foods_proposals` exist. There is no catch-all
//      match, so a typo'd collection name fails closed instead of quietly creating a new one.
//
// Deliberately NOT restricted further for the event log: a client may write a tombstone for a row it
// holds, and may update its own rows. The food catalogue is the exception: clients can add pending foods
// and propose renames, but the published reference document is read-only to them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function oneOfTheTwo() {
      return signedIn() && request.auth.uid in [
        'REPLACE_WITH_FIRST_UID',
        'REPLACE_WITH_SECOND_UID'
      ];
    }

    match /children/{childId} {
      allow read, write: if oneOfTheTwo();
    }

    match /events/{eventId} {
      allow read, write: if oneOfTheTwo();
    }

    match /foods_pending/{foodId} {
      allow read, write: if oneOfTheTwo();
    }

    match /foods_proposals/{foodId} {
      allow read, write: if oneOfTheTwo();
    }

    // Published by the owner in the console. The clients read one `food_catalogue` document and never
    // write it; edits become proposals in `foods_proposals` until the owner promotes them.
    match /reference/{documentId} {
      allow read: if oneOfTheTwo();
      allow write: if false;
    }
  }
}
