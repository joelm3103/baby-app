# Local working folders: research notes and reference frames (regenerable), and the design
# skill an agent loads while working in this repo. Not part of the app's build.
research/
.hermes/

# Android / Gradle
.gradle/
.kotlin/
local.properties
captures/
app/build/
*.apk
*.aab
# Keystore: never commit. Phase 9 keeps it backed up outside the repo.
*.keystore
*.jks

# Release signing metadata (Phase 16): holds the keystore password, so it is local-only in exactly the
# same way firebase.properties is. The script that creates the key writes this file OUTSIDE the repo;
# this line covers the repo-root variant that app/build.gradle.kts also reads.
keystore.properties

# Firebase configuration: carries the project's keys, so it is local-only like the keystore.
# Phase 13 reads it through Gradle into BuildConfig; see the note in app/build.gradle.kts.
firebase.properties
app/google-services.json

# Build/run logs — regenerable, and the full text of any run is in the terminal history anyway.
logs/

# Device captures written by scripts/capture-timeline.ps1 — regenerable, kept off the repo.
docs/timeline/

# Generated by scripts/huckleberry-import.py — a backup and a report that CONTAIN the family's real
# health log (names, weights, measurements). They belong outside the repo; this keeps a run started
# from the repo root from staging one by accident.
babylog-import*.json
babylog-import-report.md

